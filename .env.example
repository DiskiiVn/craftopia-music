# ==========================================
# CRAFTOPIA MUSIC - CẤU HÌNH CLUSTER MULTI-BOT
# ==========================================

# Token của Bot chính (Bot #1)
DISCORD_TOKEN=

# Token của các Bot phụ thay thế khi Bot 1 bận (Hỗ trợ không giới hạn số lượng Bot)
# Nếu Bot 1 đang phát ở phòng thoại 1, Bot 2 sẽ tự động vào phòng thoại 2, Bot 3 vào phòng thoại 3,...
DISCORD_TOKEN_2=
DISCORD_TOKEN_3=
# Hoặc khai báo dạng danh sách: DISCORD_TOKENS=token1,token2,token3

# Client ID của ứng dụng Discord chính (để xác thực OAuth2 Dashboard)
CLIENT_ID=

# Client Secret (Lấy trong mục OAuth2 của Discord Portal)
CLIENT_SECRET=

# Cổng chạy API Backend (trên Pterodactyl mặc định là 25610 hoặc PORT được cấp)
PORT=25610

# Domain chính thức của Web Dashboard
APP_DOMAIN=https://music.craftopics.online

# URL Callback sau khi đăng nhập Discord OAuth2
REDIRECT_URI=https://music.craftopics.online/api/auth/callback

# Chuỗi khoá bảo mật Session
SESSION_SECRET=craftopia_music_ultra_secret_key_2026
