# Token của Discord Bot (Lấy từ https://discord.com/developers/applications)
DISCORD_TOKEN=

# Client ID của ứng dụng Discord
CLIENT_ID=

# Client Secret (Lấy trong mục OAuth2 của Discord Portal)
CLIENT_SECRET=

# Cổng chạy Web Dashboard Spotify
PORT=3000

# URL Callback sau khi đăng nhập Discord OAuth2
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Chuỗi khoá bảo mật Session
SESSION_SECRET=rythm_spotify_super_secret_key_2026
