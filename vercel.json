{
  "version": 2,
  "cleanUrls": true,
  "public": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://craftopia-music.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://craftopia-music.onrender.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
